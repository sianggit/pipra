{
  "name": "pipra-ci",
  "version": "1.5.0",
  "description": "Enterprise-grade continuous delivery and deployment orchestration platform with zero-downtime cutover and SLSA provenance",
  "main": "server.js",
  "bin": {
    "pipra": "./bin/pipra.js",
    "pipra-ci": "./bin/pipra.js"
  },
  "files": [
    "bin/",
    "src/",
    "public/",
    "server.js",
    "package.json",
    "README.md",
    "LICENSE"
  ],
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test test/**/*.test.js",
    "test:unit": "node --test test/unit/*.test.js",
    "test:integration": "node --test test/integration/*.test.js",
    "db:reset": "node scripts/reset-db.js",
    "db:flush": "node scripts/reset-db.js",
    "db:demo": "node scripts/reset-db.js --demo",
    "ref": "node scripts/ref.js"
  },
  "keywords": [
    "deployment",
    "pipeline",
    "release-engineering",
    "devops",
    "docker",
    "blue-green",
    "ci-cd",
    "gitops",
    "slsa",
    "dora-metrics"
  ],
  "author": "Anggit Arisa Siwi Pratama",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  }
}
